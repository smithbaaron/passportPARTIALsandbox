    <description>Before-save. For each color's milestone checkbox (Pink Strategy Aligned, Red Narrative Approved, Blue Pricing Approved, Gold Executive Approval, Green Final QC Complete): when checked, stamps Approved By (the saving user), Approved Date and the color's Completed Date; when unchecked, clears all three. Locks pricing while Blue is complete. Counts backward stage moves in Send Back Count. Per the Oct 8 Prop Ops decision there are no per-person sign-offs and no clearing on send-back.</description>
    <environments>Default</environments>
    <formulas>
        <name>fIsSendBack</name>
        <dataType>Boolean</dataType>
        <expression>AND(CASE(TEXT({!$Record.Color_Review_Stage__c}), "Pink Review",1, "Red Review",2, "Blue Review",3, "Gold Review",4, "Green Review",5, "Complete",6, 0) &lt; CASE(TEXT({!$Record__Prior.Color_Review_Stage__c}), "Pink Review",1, "Red Review",2, "Blue Review",3, "Gold Review",4, "Green Review",5, "Complete",6, 0), CASE(TEXT({!$Record.Color_Review_Stage__c}), "Pink Review",1, "Red Review",2, "Blue Review",3, "Gold Review",4, "Green Review",5, "Complete",6, 0) &gt;= 1, CASE(TEXT({!$Record.Color_Review_Stage__c}), "Pink Review",1, "Red Review",2, "Blue Review",3, "Gold Review",4, "Green Review",5, "Complete",6, 0) &lt;= 5)</expression>
    </formulas>
    <formulas>
        <name>fSendBackNext</name>
        <dataType>Number</dataType>
        <expression>BLANKVALUE({!$Record.Send_Back_Count__c}, 0) + 1</expression>
        <scale>0</scale>
    </formulas>
