<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>D_Which</name>
        <label>Due tomorrow or overdue?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Nothing due</defaultConnectorLabel>
        <rules>
            <name>Due_tomorrow</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Active_Due_Date__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>fTomorrow</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Color_Review_Stage__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Complete</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Color_Review_Stage__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Not Started</stringValue>
                </rightValue>
            </conditions>
            <connector>
                    <targetReference>Notify_Reminder</targetReference>
            </connector>
            <label>Closes tomorrow</label>
        </rules>
        <rules>
            <name>Overdue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Active_Due_Date__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>fYesterday</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Color_Review_Stage__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Complete</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Color_Review_Stage__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Not Started</stringValue>
                </rightValue>
            </conditions>
            <connector>
                    <targetReference>Notify_Overdue</targetReference>
            </connector>
            <label>Past due</label>
        </rules>
    </decisions>
    <description>Runs every morning. For each bid in Response In Progress with an Active Due Date: posts a reminder the day before the current color closes, and an overdue notice the day after. Replaces the record-triggered Color Review Reminders flow, which could only schedule reminders for the first color.</description>
    <environments>Default</environments>
    <formulas>
        <name>fTomorrow</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 1</expression>
    </formulas>
    <formulas>
        <name>fYesterday</name>
        <dataType>Date</dataType>
        <expression>TODAY() - 1</expression>
    </formulas>
    <interviewLabel>Color Review Reminders (Daily) {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Color Review Reminders (Daily)</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>D_Which</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CapStrat_Stage__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Response In Progress</stringValue>
            </value>
        </filters>
        <filters>
            <field>Active_Due_Date__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Capture_Strategy__c</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-10-09</startDate>
            <startTime>08:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Notify_Reminder</name>
        <label>Post reminder</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>Color_Review_Notify</flowName>
        <inputAssignments>
            <name>recordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>message</name>
            <value>
                <elementReference>ttReminder</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>slackEmail</name>
            <value>
                <elementReference>$Record.Slack_Channel_Email__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>subject</name>
            <value>
                <elementReference>ttSubject</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <subflows>
        <name>Notify_Overdue</name>
        <label>Post overdue</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>Color_Review_Notify</flowName>
        <inputAssignments>
            <name>recordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>message</name>
            <value>
                <elementReference>ttOverdue</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>slackEmail</name>
            <value>
                <elementReference>$Record.Slack_Channel_Email__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>subject</name>
            <value>
                <elementReference>ttSubject</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <textTemplates>
        <name>ttReminder</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>⏰ {!$Record.Color_Review_Stage__c} for {!$Record.Name} closes tomorrow at 5:00pm ET. Outstanding sign-offs — please check your box on the record.</text>
    </textTemplates>
    <textTemplates>
        <name>ttOverdue</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>🚨 {!$Record.Color_Review_Stage__c} for {!$Record.Name} is past due. Please complete outstanding sign-offs.</text>
    </textTemplates>
    <textTemplates>
        <name>ttSubject</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>[Color Review] {!$Record.Name}</text>
    </textTemplates>
</Flow>
