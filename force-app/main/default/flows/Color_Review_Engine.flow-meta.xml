            <name>Opened_Green</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Color_Review_Stage__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Color_Review_Stage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Green Review</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Notify_Green</targetReference>
            </connector>
            <label>Green</label>
        </rules>
        <rules>
            <name>Now_complete</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Color_Review_Stage__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Color_Review_Stage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Complete</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Notify_Complete</targetReference>
            </connector>
            <label>Complete</label>
        </rules>
    </decisions>
    <description>After-save. (1) When a bid is in Response In Progress with a Submission Deadline, computes each color's Target Date from the Target Offset in Color Review Config metadata. (2) When a color is opened, sets its Due Date and the Active Due Date from the SLA in that metadata. (3) Writes those in a single update, then posts to Chatter and the bid's Slack channel when a color opens, when all reviews complete, and when a previously set deadline moves. Entry conditions keep it off every other save.</description>
    <environments>Default</environments>
    <formulas>
        <name>fToday</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>fNegOffset</name>
        <dataType>Number</dataType>
        <expression>{!Loop_Config.Target_Offset_Bus_Days__c} * -1</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Color Review Engine {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Color Review Engine</label>
    <loops>
        <name>Loop_Config</name>
        <label>Each configured color</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Config_All</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Sub_Target</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <isGoTo>true</isGoTo>
            <targetReference>D_Color</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
