    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>D_Targets</targetReference>
        </connector>
        <filterFormula>OR(ISNEW(), ISCHANGED({!$Record.Submission_Deadline__c}), ISCHANGED({!$Record.CapStrat_Stage__c}), ISCHANGED({!$Record.Color_Review_Stage__c}))</filterFormula>
        <object>Capture_Strategy__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
