        <filters>
            <field>Stage_Value__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Color_Review_Stage__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Color_Review_Config__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
