<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Init_Lists</name>
        <label>Init holiday lists</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>holidayDates</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>|</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>holidayMonthDays</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>|</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Holidays</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Collect_Holiday</name>
        <label>Collect holiday</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>holidayDates</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>fHolidayExact</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>holidayMonthDays</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>fHolidayMonthDay</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Holidays</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Init</name>
        <label>Init</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>curDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>inDate</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>remaining</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fAbsDays</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>More_days</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Step_one_day</name>
        <label>Step one day</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>curDate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>fStep</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Business_day_check</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Count_it</name>
        <label>Count it</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>remaining</assignToReference>
            <operator>Subtract</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>More_days</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_output</name>
        <label>Set output</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>curDate</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>More_days</name>
        <label>More days?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_output</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Done</defaultConnectorLabel>
        <rules>
            <name>Yes_more</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>remaining</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                    <targetReference>Step_one_day</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Business_day_check</name>
        <label>Business day?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>More_days</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Weekend or holiday</defaultConnectorLabel>
        <rules>
            <name>Is_business_day</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fIsBusinessDay</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                    <targetReference>Count_it</targetReference>
            </connector>
            <label>Business day</label>
        </rules>
    </decisions>
    <description>Adds (or subtracts, when inDays is negative) a number of business days to inDate. Skips weekends and any date listed in Setup &gt; Holidays (exact-date holidays and yearly recurring holidays on a fixed month/day).</description>
    <environments>Default</environments>
    <formulas>
        <name>fAbsDays</name>
        <dataType>Number</dataType>
        <expression>CEILING(ABS({!inDays}))</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fStep</name>
        <dataType>Number</dataType>
        <expression>IF({!inDays} &lt; 0, -1, 1)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fIsBusinessDay</name>
        <dataType>Boolean</dataType>
        <expression>AND(MOD({!curDate} - DATE(1900,1,7), 7) &gt; 0, MOD({!curDate} - DATE(1900,1,7), 7) &lt; 6, NOT(CONTAINS({!holidayDates}, "|" &amp; TEXT({!curDate}) &amp; "|")), NOT(CONTAINS({!holidayMonthDays}, "|" &amp; MID(TEXT({!curDate}),6,5) &amp; "|")))</expression>
    </formulas>
    <formulas>
        <name>fHolidayExact</name>
        <dataType>String</dataType>
        <expression>IF({!Loop_Holidays.IsRecurrence}, "", TEXT({!Loop_Holidays.ActivityDate}) &amp; "|")</expression>
    </formulas>
    <formulas>
        <name>fHolidayMonthDay</name>
        <dataType>String</dataType>
        <expression>IF(AND({!Loop_Holidays.IsRecurrence}, TEXT({!Loop_Holidays.RecurrenceType}) = "RecursYearly"), MID(TEXT({!Loop_Holidays.ActivityDate}),6,5) &amp; "|", "")</expression>
    </formulas>
    <interviewLabel>Add Business Days {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Add Business Days</label>
    <loops>
        <name>Loop_Holidays</name>
        <label>Each holiday</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Holidays</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Collect_Holiday</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Init</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Holidays</name>
        <label>Get org holidays</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Init_Lists</targetReference>
        </connector>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Holiday</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>ActivityDate</queriedFields>
        <queriedFields>IsRecurrence</queriedFields>
        <queriedFields>RecurrenceType</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Holidays</targetReference>
        </connector>
    </start>
    <status>Active</status>
