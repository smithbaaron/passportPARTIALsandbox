<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Sign_Off_PropOps_Only</fullName>
    <active>true</active>
    <errorConditionFormula>NOT($Permission.Bypass_Color_Review_Gates) &amp;&amp;
NOT($Permission.Color_Review_Sign_PropOps) &amp;&amp;
((ISCHANGED(Pink_SO_PropOps__c) &amp;&amp; Pink_SO_PropOps__c) ||
   (ISCHANGED(Red_SO_PropOps__c) &amp;&amp; Red_SO_PropOps__c) ||
   (ISCHANGED(Blue_SO_PropOps__c) &amp;&amp; Blue_SO_PropOps__c) ||
   (ISCHANGED(Gold_SO_PropOps__c) &amp;&amp; Gold_SO_PropOps__c) ||
   (ISCHANGED(Green_SO_PropOps__c) &amp;&amp; Green_SO_PropOps__c))</errorConditionFormula>
    <errorDisplayField>Pink_SO_PropOps__c</errorDisplayField>
    <errorMessage>Only Proposal Ops can sign off the Proposal Ops box. You can clear a sign-off, but not set it. Ask an admin for the Color Review Signer - Proposal Ops permission set if you hold this role.</errorMessage>
</ValidationRule>
